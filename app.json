{
  "expo": {
    "name": "UniTrack",
    "slug": "UniTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#080712"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.guyze.UniTrack"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080712",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8e5d834d-8b8e-438d-9f79-a94ea349088b"
      }
    }
  }
}
